{
  "name": "@zanreal/medusa-admin-kit",
  "version": "0.2.1",
  "description": "Medusa v2 toolkit for an extensible admin products list. Sibling plugins register their own columns through a shared registry and they all render in one products table, instead of each plugin shipping a separate page.",
  "keywords": [
    "admin",
    "column-registry",
    "dashboard",
    "data-table",
    "extensible",
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "products"
  ],
  "homepage": "https://zanreal.com/docs/oss/medusa-admin-kit",
  "bugs": {
    "url": "https://github.com/zanreal-labs/medusa-admin-kit/issues"
  },
  "license": "MIT",
  "author": "ZanReal Labs (https://zanreal.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/medusa-admin-kit.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    ".medusa/server",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./.medusa/server/src/index.js",
  "module": "./.medusa/server/src/index.mjs",
  "types": "./.medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "import": "./.medusa/server/src/index.mjs",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && node scripts/build-esm-entry.mjs",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:admin": "tsc --noEmit -p src/admin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "medusa plugin:build && node scripts/build-esm-entry.mjs",
    "prepare": "medusa plugin:build && node scripts/build-esm-entry.mjs"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/eslint-plugin": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/types": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "@swc/core": "^1.16.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "react-router-dom": "7.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.13.0"
}
